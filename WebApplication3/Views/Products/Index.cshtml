@model IEnumerable<WebApplication3.Models.Product>

@{
    ViewData["Title"] = "Каталог товаров";
}

<h1>Каталог товаров</h1>

<p>
    <a asp-action="Create" class="btn btn-pink">Создать новый</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Название</th>
            <th>Цена</th>
            <th>Категория</th>
            <th>Описание</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Price.ToString()</td>
                <td>@(item.Category?.CategoryName ?? "—")</td>
                <td>@(item.Description ?? "—")</td>
                <td>
                    <a asp-controller="Cart" asp-action="Add" asp-route-id="@item.ProductId" class="btn btn-pink btn-sm">В корзину</a>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProductId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ProductId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ProductId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>