@{
    ViewData["Title"] = "Страница не найдена";
}

<div class="text-center" style="padding: 60px 20px;">
    <div style="font-size: 120px; font-weight: bold; color: #ff69b4; line-height: 1;">404</div>
    <h1 style="color: #d44b8c;">Упс! Страница не найдена</h1>
    <p class="lead" style="color: #d44b8c;">
        Возможно, страница была удалена, или вы ввели неверный адрес.
    </p>
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-pink">На главную</a>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-pink">В каталог</a>
    </div>
</div>